{
  "mcpServers": {
    "aseprite": {
      "command": "uv",
      "args": ["--directory", "/path/to/aseprite-mcp", "run", "-m", "aseprite_mcp"],
      "env": {
        "ASEPRITE_PATH": "/path/to/aseprite"
      }
    },
    "godot-mcp": {
      "command": "node",
      "args": ["/path/to/Godot-MCP/server/dist/index.js"],
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    },
    "blockbench": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "http://localhost:3000/bb-mcp"]
    },
    "audacity": {
      "command": "python",
      "args": ["-m", "audacity_mcp"]
    }
  }
}
