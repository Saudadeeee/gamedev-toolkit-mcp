# ============================================================
# GameDev Toolkit MCP — root .gitignore
# ============================================================
#
# Every MCP server now lives under servers/ and is tracked, including the
# vendored ones. Broad patterns are therefore dangerous: a global `build/` or
# `*.png` silently drops upstream source and breaks the "vendored verbatim"
# claim in COPYRIGHT. Anything that is not a universal build artefact is scoped
# to the directory that actually produces it.

# ============================================================
# Generated by the setup scripts — absolute local paths and API keys
# ============================================================
mcp_config.json

# ============================================================
# Universal build artefacts — safe to ignore anywhere
# ============================================================
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ============================================================
# Compiled output — scoped, because `build/` and `dist/` are real
# source directories in some vendored projects
# ============================================================
/servers/godot/server/dist/
/servers/aseprite/dist/
/servers/aseprite/build/
/dist/
/build/

# ============================================================
# Godot Engine
# ============================================================
.godot/
*.import
*.translation

# Export output
/servers/godot/export/
*.apk
*.aab
*.ipa
*.x86_64
*.dmg

# ============================================================
# Aseprite test output — scoped to where the suites actually write
# ============================================================
# These are generated sprites and exported art. They belong in a game project,
# not here. Scoped so vendored docs images and icons survive.
/servers/aseprite/**/*.aseprite
/servers/aseprite/**/*.ase
/servers/aseprite/**/*.png
/servers/aseprite/**/*.gif
/servers/aseprite/**/*.webp
/servers/aseprite/**/*.lua
/*.aseprite
/*.ase
/*.png
/*.gif
/*.webp

# ============================================================
# Environment & secrets
# ============================================================
.env
.env.local
.env.*.local
*.env
# sample.env is the tracked template the real .env is copied from.
!sample.env

# ============================================================
# AI agent local settings (contain personal paths/permissions)
# ============================================================
# .claude/skills/ is project content and IS tracked -- only the local
# machine's settings are personal.
.claude/settings.local.json
**/.claude/settings.json
.cursor/
.aider*
.continue/

# ============================================================
# IDE & editor
# ============================================================
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# .vscode/ is ignored for this repo's own root, but the vendored projects ship
# their own and are tracked verbatim.
/.vscode/
/servers/godot/.vscode/

# ============================================================
# OS
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================================
# Logs & temp
# ============================================================
logs/
*.log
tmp/
temp/
.cache/
