{
  "name": "godot-mcp-server",
  "version": "1.0.0",
  "description": "Godot 4 MCP server -- scenes, nodes, scripts, signals, capture and headless builds",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec \"tsc && node dist/index.js\"",
    "test": "echo \"Pass a project path: npm run test:headless -- <project>\" && exit 1",
    "test:headless": "node tests/headless_test.mjs",
    "test:editor": "node tests/editor_test.mjs"
  },
  "keywords": [
    "godot",
    "mcp",
    "fastmcp",
    "claude",
    "ai"
  ],
  "author": "Saudade",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "fastmcp": "^1.27.7",
    "websocket": "^1.0.35",
    "ws": "^8.21.1",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "nodemon": "^2.0.22",
    "typescript": "^5.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Saudadeeee/gamedev-toolkit-mcp"
  }
}
